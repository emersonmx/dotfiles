{
    "mcpServers": {
        "codegraph": {
            "args": ["serve", "--mcp"],
            "command": "codegraph",
            "disabled": false
        },
        "context-mode": {
            "args": ["-y", "context-mode"],
            "command": "npx"
        },
        "fetch": {
            "args": ["mcp-server-fetch"],
            "command": "/usr/bin/uvx"
        },
        "filesystem": {
            "args": ["-y", "@modelcontextprotocol/server-filesystem"],
            "command": "npx"
        },
        "sequentialthinking": {
            "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
            "command": "npx"
        }
    }
}
